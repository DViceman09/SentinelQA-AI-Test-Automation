# Copy to .env. Read by docker compose, the Java tests and security/strix.sh.
# Real environment variables and -Dkey=value flags override these values.

# ---- System under test --------------------------------------------------
# true = plant known defects: SQL injection, IDOR, missing security headers, stock not decremented
SHOPLITE_DEFECTS=false
# true = rename buttons (simulated UI redesign) to demo AI self-healing locators
SHOPLITE_REDESIGN=false

# ---- AI features (any OpenAI-compatible endpoint) -----------------------
# Leave AI_BASE_URL empty to switch every AI feature off; tests still run normally.
# OmniRoute: self-hosted gateway over free providers (https://github.com/diegosouzapw/OmniRoute)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=auto
# Other free options (check the provider's current free model list):
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1                         AI_MODEL=<model id ending in :free>
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama      AI_BASE_URL=http://localhost:11434/v1                           AI_MODEL=qwen2.5-coder:7b

# ---- Strix AI pentest (falls back to the AI_* values above) -------------
# LiteLLM model name; "openai/" means "any OpenAI-compatible endpoint at AI_BASE_URL"
STRIX_LLM=openai/auto
